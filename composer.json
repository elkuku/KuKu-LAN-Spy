{
    "name": "elkuku/kuku-lan-spy",
    "description": "Inventory the devices on the local LAN and render them as JSON and HTML",
    "type": "project",
    "license": "WTFPL",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "twig/twig": "^3.30"
    },
    "autoload": {
        "psr-4": {
            "LanSpy\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "twig": "twig-cs-fixer lint templates",
        "twig:fix": "twig-cs-fixer fix templates",
        "biome": "node_modules/.bin/biome check",
        "biome:fix": "node_modules/.bin/biome check --write",
        "shell": [
            "shellcheck lan-spy.sh lan-watch.sh",
            "shfmt --diff lan-spy.sh lan-watch.sh"
        ],
        "shell:fix": "shfmt --write lan-spy.sh lan-watch.sh",
        "fix": [
            "@cs:fix",
            "@rector:fix",
            "@twig:fix",
            "@biome:fix",
            "@shell:fix"
        ],
        "check": [
            "@cs",
            "@rector",
            "@analyse",
            "@twig",
            "@biome",
            "@shell"
        ]
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan",
        "rector": "Show the changes Rector would make",
        "rector:fix": "Apply the Rector changes",
        "cs": "Check the PHP coding style",
        "cs:fix": "Fix the PHP coding style",
        "twig": "Lint the Twig templates",
        "twig:fix": "Fix the Twig template style",
        "biome": "Lint and check the formatting of the JS and CSS",
        "biome:fix": "Fix the JS and CSS formatting and safe lint issues",
        "shell": "Lint (ShellCheck) and check the formatting (shfmt) of the shell scripts",
        "shell:fix": "Format the shell scripts",
        "fix": "Apply all the fixers",
        "check": "Run all the checks without changing anything"
    }
}
