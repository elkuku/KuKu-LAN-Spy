{
    "name": "elkuku/kuku-lan-spy",
    "description": "Inventory the devices on the local LAN and render them as JSON and HTML",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*"
    },
    "autoload": {
        "psr-4": {
            "LanSpy\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7"
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@rector",
            "@analyse"
        ]
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan",
        "rector": "Show the changes Rector would make",
        "rector:fix": "Apply the Rector changes",
        "cs": "Check the coding style",
        "cs:fix": "Fix the coding style",
        "check": "Run the coding style check, Rector and PHPStan"
    }
}
